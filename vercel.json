{
  "buildCommand": "node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "devCommand": "npx vite",
  "installCommand": "npm install",
  "functions": {
    "_api/*.js": {
      "runtime": "nodejs@20.x"
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/_api/$1" }]
}
