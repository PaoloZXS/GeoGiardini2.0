                    cliente_id: appt.cliente_id?.toString() || "",
                    giardiniere_ids: giardiniereIds,
                    aggiungi_al_planning: true,
                    stato: "promemoria"
                  };
                  setLinkedAppuntamentoId(appId);
                  setAttivitaModalEditData(editData);
