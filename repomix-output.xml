                      <tr key={item.id} className={`border-b border-[#e2e8f0] hover:bg-[#f1f5f9] transition cursor-pointer ${idx % 2 === 1 ? "bg-[#f8fafc]" : "bg-white"}`}
                        onClick={() => handleSelectItem(item)}>
                        <td className="py-2 px-3 font-bold text-[#1e293b] border-r border-[#e2e8f0]">{item.categorie?.nome}</td>
