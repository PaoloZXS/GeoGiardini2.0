VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (VAPID) - obbligatorio per PC/browser
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Supabase Service Role - per backend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Firebase Admin SDK (FCM per Android nativo) - opzionale
# Genera: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=base64-of-firebase-service-account-json
